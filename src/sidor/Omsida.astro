---
import Ram from '../layouts/Ram.astro';
import Kontaktvagar from '../components/Kontaktvagar.astro';
import Maskot from '../components/Maskot.astro';
import { sajt, kontakt, type Sprak } from '../config/sajt';
import { t } from '../i18n/ord';

interface Props {
  sprak: Sprak;
}
const { sprak } = Astro.props;
const harKontakt = Object.values(kontakt).some(Boolean);
const text = {
  sv: [
    'Victoria Wendelid, som också kallar sig Vicky Variety, arbetar i tre spår som sällan möts. Hon modellerar exakta CAD-detaljer för industrin, bygger och animerar 3D-figurer för spel och ritar små gulliga illustrationer.',
    'Det som binder ihop dem är att hon tänker i berättelser. En ventil har en historia om flöde och toleranser, en spelfigur har en historia om hur den rör sig, och ett litet moln har en historia om att vilja höra till.',
  ],
  en: [
    'Victoria Wendelid, also known as Vicky Variety, works in three tracks that rarely meet. She models precise CAD parts for industry, builds and animates 3D characters for games and draws small, cute illustrations.',
    'What ties them together is that she thinks in stories. A valve has a story about flow and tolerances, a game character has a story about how it moves, and a small cloud has a story about wanting to belong.',
  ],
};
---
<Ram sprak={sprak} tema="start" titel={t(sprak, 'omRubrik')} beskrivning={text[sprak][0]} vag="/om/">
  <div class="vs-projektkropp">
    <div class="stack" style="gap: var(--mellanrum-3)">
      <h1>{t(sprak, 'omRubrik')}</h1>
      {text[sprak].map((stycke) => <p class="ingress">{stycke}</p>)}
      <h2>{t(sprak, 'kontakt')}</h2>
      {
        harKontakt ? (
          <Kontaktvagar sprak={sprak} />
        ) : (
          <p>{sprak === 'sv' ? 'Kontaktuppgifter kommer snart.' : 'Contact details coming soon.'}</p>
        )
      }
    </div>
    <aside>
      <Maskot etikett={sprak === 'sv' ? `${sajt.namn}s märke, en kub med ansikte` : `The ${sajt.namn} mark, a cube with a face`} class="vs-om-maskot" />
    </aside>
  </div>
</Ram>
<style>
  :global(.vs-om-maskot) {
    width: min(60%, 260px);
  }
</style>
